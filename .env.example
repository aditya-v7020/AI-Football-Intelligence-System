# =========================================================
# AI Football Intelligence System — Environment Variables
# =========================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# =========================================================

# Groq API Key (for Llama 3.3 70B multi-agent LLM)
GROQ_API_KEY=your_groq_api_key_here

# API-Football Key (Primary structured player stats)
FOOTBALL_API_KEY=your_football_api_key_here

# Tavily API Key (Real-time web research)
TAVILY_API_KEY=your_tavily_api_key_here

# Sportmonks API Token (Secondary player data source)
SPORTMONKS_API_KEY=your_sportmonks_api_key_here

# TheSportsDB API Key (Player photo & bio fallback)
THESPORTSDB_API_KEY=123

# Football-Data.org API Key (Standings & Fixtures)
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# PostgreSQL Database URL (for LangGraph conversation memory checkpointing)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/langgraph_memory_demo

# --- Server & Production Configuration ---

# Football season (defaults to 2024)
FOOTBALL_SEASON=2024

# LLM model & temperature
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2

# Backend Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Production-safe CORS Allowed Origins (comma-separated)
CORS_ORIGINS=https://ai-football-intelligence-system.vercel.app,http://localhost:5173


# Frontend API Base URL (used by Vite frontend)
VITE_API_BASE_URL=https://ai-football-intelligence-system.onrender.com

